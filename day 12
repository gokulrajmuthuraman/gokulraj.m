Fibonacci:
def fib(n):
    if n==0:
        return 0
    if n==1:
        return 1
    return fib(n-1)+fib(n-2)
print(fib(10))

def rev(n):
    if len(n)==1:
        return n
    return n[-1]+rev(n[:-1])
a="rahul"
print(rev(a))

def minimum(n):
    if len(n)==1:
        return n[0]
    return min(n[0],minimum(n[1:]))
arr=[10,8,5,23,0]
print(minimum(arr))

