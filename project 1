/* General Settings */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f7fa;
    color: #222;
}


/* Navigation Bar */

header {
    background: #111827;
    position: sticky;
    top: 0;
    z-index: 1000;
}

nav {
    max-width: 1100px;
    margin: auto;
    padding: 18px 20px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: white;
    font-size: 28px;
}

nav ul {
    display: flex;
    list-style: none;
    gap: 25px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-size: 16px;
}

nav ul li a:hover {
    color: #38bdf8;
}


/* Home Section */

.home {
    min-height: 90vh;

    display: flex;
    justify-content: center;
    align-items: center;

    text-align: center;

    background: linear-gradient(135deg, #dbeafe, #f0f9ff);
}

.home-content {
    max-width: 700px;
    padding: 30px;
}

.home h1 {
    font-size: 48px;
    margin-bottom: 15px;
}

.home h1 span {
    color: #0284c7;
}

.home h2 {
    font-size: 25px;
    margin-bottom: 20px;
}

.home p {
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 30px;
}


/* Button */

.btn {
    display: inline-block;

    padding: 12px 25px;

    background: #0284c7;
    color: white;

    text-decoration: none;

    border-radius: 6px;

    transition: 0.3s;
}

.btn:hover {
    background: #0369a1;
    transform: scale(1.05);
}


/* Common Section */

.section {
    max-width: 1100px;
    margin: auto;
    padding: 80px 20px;
}

.title {
    text-align: center;
    font-size: 35px;
    margin-bottom: 40px;
    color: #111827;
}


/* About */

.about-content {
    max-width: 800px;
    margin: auto;
    text-align: center;
}

.about-content p {
    font-size: 17px;
    line-height: 1.8;
    margin-bottom: 20px;
}


/* Skills */

.skills-container {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.skill-card {
    background: white;

    padding: 30px;

    text-align: center;

    border-radius: 10px;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);

    transition: 0.3s;
}

.skill-card:hover {
    transform: translateY(-8px);
}

.skill-card h3 {
    color: #0284c7;
    margin-bottom: 12px;
}

.skill-card p {
    line-height: 1.6;
}


/* Projects */

.projects-container {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 25px;
}

.project-card {
    background: white;

    padding: 30px;

    border-radius: 10px;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);

    transition: 0.3s;
}

.project-card:hover {
    transform: translateY(-8px);
}

.project-card h3 {
    color: #0284c7;
    margin-bottom: 15px;
}

.project-card p {
    line-height: 1.6;
    margin-bottom: 20px;
}

.project-card span {
    display: inline-block;

    background: #e0f2fe;

    color: #0369a1;

    padding: 6px 12px;

    margin-right: 5px;

    border-radius: 5px;

    font-size: 13px;
}


/* Contact */

.contact-box {
    background: white;

    max-width: 600px;

    margin: auto;

    padding: 30px;

    border-radius: 10px;

    text-align: center;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
}

.contact-box p {
    margin: 15px 0;
}

.contact-box a {
    color: #0284c7;
    text-decoration: none;
}


/* Footer */

footer {
    background: #111827;

    color: white;

    text-align: center;

    padding: 25px;
}


/* Responsive Design */

@media (max-width: 768px) {

    nav {
        flex-direction: column;
        gap: 15px;
    }

    nav ul {
        gap: 12px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .home h1 {
        font-size: 36px;
    }

    .home h2 {
        font-size: 21px;
    }

    .skills-container {
        grid-template-columns: 1fr;
    }

    .projects-container {
        grid-template-columns: 1fr;
    }

}
